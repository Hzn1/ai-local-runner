{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capabilities for the main window. No shell, no broad filesystem access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "clipboard-manager:default",
    "updater:default",
    "process:allow-restart",
    "window-state:default"
  ]
}
