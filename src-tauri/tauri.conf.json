{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TNN Local AI",
  "version": "0.1.0",
  "identifier": "ai.tnn.localai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TNN Local AI",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/engine/*",
      "resources/engine-baseline/*"
    ],
    "category": "Productivity",
    "shortDescription": "Private AI chat on your own PC",
    "longDescription": "Download an ultra-light model once, then chat privately. No account, no cloud, no telemetry.",
    "copyright": "Copyright © 2026 TNN Local AI contributors",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.tnn.example.invalid/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5QjI2MzM4RTlCODZDQjUKUldTMWJManBPR095R2Y0VXNSU1ZEWTZuOCtNN3dhUGo4dm9KOS85c1NDcWU5RVJRQm1oSXA0bXYK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
